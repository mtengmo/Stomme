  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one full-width action per screen; action fill, action-ink text.",
      "html": "<button class=\"ds-btn-primary\">Starta pass</button>",
      "css": ".ds-btn-primary { display:flex; width:100%; align-items:center; justify-content:center; min-height:64px; padding:0 24px; border:0; border-radius:6px; background:var(--action,#23292b); color:var(--action-ink,#eef3f0); font:700 20px/1.4 system-ui, sans-serif; transition: transform 150ms ease-out, opacity 150ms ease-out; } .ds-btn-primary:active { transform:scale(0.98); } .ds-btn-primary:focus-visible { outline:3px solid var(--focus-outline,#2b4fa0); outline-offset:3px; box-shadow:var(--focus-ring,none); border-radius:4px; } .ds-btn-primary:disabled { opacity:0.5; }"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Lesser action with a thick ink outline on surface.",
      "html": "<button class=\"ds-btn-secondary\">Behåll min data</button>",
      "css": ".ds-btn-secondary { display:flex; width:100%; align-items:center; justify-content:center; min-height:56px; padding:0 24px; border:3px solid var(--ink,#23292b); border-radius:6px; background:var(--surface,#eef3f0); color:var(--ink,#23292b); font:700 20px/1.4 system-ui, sans-serif; transition: transform 150ms ease-out; } .ds-btn-secondary:active { transform:scale(0.98); } .ds-btn-secondary:focus-visible { outline:3px solid var(--focus-outline,#2b4fa0); outline-offset:3px; box-shadow:var(--focus-ring,none); border-radius:4px; }"
    },
    {
      "name": "Care Button",
      "kind": "button",
      "refersTo": "button-care",
      "description": "Stop screen action: care fill, warning icon and the word. Never colour alone.",
      "html": "<button class=\"ds-btn-care\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3L2 21h20L12 3z\"/><path d=\"M12 10v5M12 18h.01\"/></svg>Stopp</button>",
      "css": ".ds-btn-care { display:flex; width:100%; align-items:center; justify-content:center; gap:8px; min-height:64px; padding:0 24px; border:0; border-radius:6px; background:var(--care,#23292b); color:var(--care-ink,#eef3f0); font:700 20px/1.4 system-ui, sans-serif; } .ds-btn-care:active { transform:scale(0.98); } .ds-btn-care:focus-visible { outline:3px solid var(--focus-outline,#2b4fa0); outline-offset:3px; box-shadow:var(--focus-ring,none); border-radius:4px; }"
    },
    {
      "name": "State Chips",
      "kind": "chip",
      "refersTo": "chip-done",
      "description": "Klar, Idag, Kommande: colour plus icon plus word. Klar uses the pencil tick in the theme done colour.",
      "html": "<span class=\"ds-chip ds-chip-done\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 48 48\" fill=\"currentColor\"><path d=\"M6 27C8 25 10 25 13 30C18 19 28 9 42 4C43 5 43 6 41 8C30 15 22 26 17 39C15 41 13 40 12 38C10 34 8 31 5 29C5 28 5 27 6 27Z\"/></svg>Klar</span> <span class=\"ds-chip ds-chip-today\">Idag</span> <span class=\"ds-chip ds-chip-upcoming\">Kommande</span>",
      "css": ".ds-chip { display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border-radius:4px; font:700 16px/1.4 system-ui, sans-serif; } .ds-chip svg { width:18px; height:18px; } .ds-chip-done { border:2px solid var(--done-chip-border,var(--done,#b52a23)); color:var(--done-fill-ink,var(--done,#b52a23)); background:var(--done-fill,transparent); } .ds-chip-today { background:var(--today,#f0b13a); color:var(--today-ink,#23292b); } .ds-chip-upcoming { background:var(--upcoming,#dde6e2); color:var(--upcoming-ink,#3d484b); }"
    },
    {
      "name": "Set Tally",
      "kind": "custom",
      "refersTo": "set-circle",
      "description": "Row of set circles: digits for sets left, pencil tick in done-mark when done.",
      "html": "<div class=\"ds-tally\"><span class=\"ds-circle\">3</span><span class=\"ds-circle\">2</span><span class=\"ds-circle ds-done\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 48 48\" fill=\"currentColor\"><path d=\"M6 27C8 25 10 25 13 30C18 19 28 9 42 4C43 5 43 6 41 8C30 15 22 26 17 39C15 41 13 40 12 38C10 34 8 31 5 29C5 28 5 27 6 27Z\"/></svg></span></div>",
      "css": ".ds-tally { display:flex; gap:6px; } .ds-circle { display:grid; place-items:center; width:48px; height:48px; border:3px solid var(--ink,#23292b); border-radius:9999px; background:var(--surface,#eef3f0); color:var(--ink,#23292b); font:800 24px/1 'Barlow Condensed', sans-serif-condensed, sans-serif; font-variant-numeric:tabular-nums; } .ds-done { color:var(--done-mark,var(--done,#b52a23)); } .ds-done svg { width:34px; height:34px; }"
    },
    {
      "name": "Pass Card (lead)",
      "kind": "card",
      "refersTo": "pass-card-lead",
      "description": "The next pass: ink outline, surface-tint fill, big title and count; shadowless.",
      "html": "<div class=\"ds-card\"><p class=\"ds-next\">Nästa pass</p><h3 class=\"ds-title\">Underkropp A</h3><span class=\"ds-count\">0/5</span></div>",
      "css": ".ds-card { padding:20px; border:3px solid var(--ink,#23292b); border-radius:6px; background:var(--surface-tint,#eef3f0); color:var(--ink,#23292b); } .ds-next { margin:0; font:700 16px/1.4 system-ui, sans-serif; color:var(--accent,#2b4fa0); } .ds-title { margin:0; font:800 60px/1 'Barlow Condensed', sans-serif-condensed, sans-serif; } .ds-count { font:800 72px/1 'Barlow Condensed', sans-serif-condensed, sans-serif; font-variant-numeric:tabular-nums; }"
    },
    {
      "name": "Banner",
      "kind": "custom",
      "refersTo": "banner",
      "description": "Info banner: surface fill, 2px accent outline, icon plus bold sentence. Care tone swaps the outline to care.",
      "html": "<div class=\"ds-banner\"><b>Ny version finns.</b></div>",
      "css": ".ds-banner { padding:16px; border:2px solid var(--info,#2b4fa0); border-radius:6px; background:var(--surface,#eef3f0); color:var(--ink,#23292b); font:700 16px/1.4 system-ui, sans-serif; }"
    },
    {
      "name": "Stop Frame",
      "kind": "custom",
      "refersTo": "button-care",
      "description": "Care screen: paper inside a 6px care frame, warning icon plus the word Stopp, care button.",
      "html": "<div class=\"ds-stop\"><div class=\"ds-stop-head\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3L2 21h20L12 3z\"/><path d=\"M12 10v5M12 18h.01\"/></svg><b>Stopp</b></div><p>Avbryt passet och vila.</p><button class=\"ds-stop-btn\">Avbryt</button></div>",
      "css": ".ds-stop { padding:20px; border:6px solid var(--care,#23292b); background:var(--paper,#eef3f0); color:var(--ink,#23292b); font:400 20px/1.4 system-ui, sans-serif; } .ds-stop-head { display:flex; align-items:center; gap:12px; color:var(--care,#23292b); font:800 48px/1 'Barlow Condensed', sans-serif-condensed, sans-serif; } .ds-stop-head svg { width:56px; height:56px; } .ds-stop-btn { width:100%; min-height:64px; border:0; border-radius:6px; background:var(--care,#23292b); color:var(--care-ink,#eef3f0); font:700 20px/1.4 system-ui, sans-serif; }"
    },
    {
      "name": "Theme Option",
      "kind": "custom",
      "refersTo": "theme-option",
      "description": "Färgtema radio row, at least 56px tall, swatch row plus Swedish name and variant.",
      "html": "<label class=\"ds-theme\"><input type=\"radio\" name=\"t\" checked> <span class=\"ds-sw\" style=\"background:#eef3f0\"></span><span class=\"ds-sw\" style=\"background:#b52a23\"></span><span class=\"ds-sw\" style=\"background:#2b4fa0\"></span> <b>Rutat</b></label>",
      "css": ".ds-theme { display:flex; align-items:center; gap:12px; min-height:56px; padding:12px; border:3px solid var(--ink,#23292b); border-radius:6px; background:var(--surface,#eef3f0); color:var(--ink,#23292b); font:700 16px/1.4 system-ui, sans-serif; } .ds-sw { width:24px; height:24px; border:2px solid var(--ink,#23292b); border-radius:4px; }"
    },
    {
      "name": "Bottom Nav Tab",
      "kind": "nav",
      "refersTo": "nav-tab-active",
      "description": "Surface-tint bar with a 3px ink top rule; active tab is bold ink with a 4px ink underline.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-tab ds-tab-active\">Vecka</a><a class=\"ds-tab\">Historik</a><a class=\"ds-tab\">Inställningar</a></nav>",
      "css": ".ds-nav { display:flex; background:var(--surface-tint,#eef3f0); border-top:3px solid var(--ink,#23292b); } .ds-tab { flex:1; display:grid; place-items:center; min-height:64px; border-bottom:4px solid transparent; color:var(--ink-soft,#4a5659); font:700 16px/1.4 system-ui, sans-serif; } .ds-tab-active { color:var(--ink,#23292b); border-bottom-color:var(--ink,#23292b); } .ds-tab:focus-visible { outline:3px solid var(--focus-outline,#2b4fa0); outline-offset:3px; box-shadow:var(--focus-ring,none); border-radius:4px; }"
    }
  ],
  "narrative": {
    "northStar": "The Squared Notebook",
    "overview": "Stomme is a training diary written on squared paper. Ink carries the content, the accent colour marks the working side (focus, selection, the next pass, info), and each theme spends exactly one colour on one meaning: done. The default theme, Rutat, is pale green-grey paper with graphite ink and a red pencil. The page itself is the surface; there is no card shadow, no glass, no gradient. The 24 px grid is printed on the body and everything sits on it, except in Hög kontrast, where the grid is switched off.\n\nThe system is built for a phone held at arm's length on the floor: heavy 3 px outlines, text never below 16 px, targets 44 px and up (primary actions 56-64 px), counts set in a tall condensed heavy face so the number reads from across a room. State is always word plus icon plus colour, never colour alone. The pencil-tick shape is the same in every theme; only its colour changes.\n\nFour themes ship, each in a light and a dark scheme, chosen on the device (see Colors, Themes): Rutat (default, Restrained), Hav \"Lagun\" (Committed, teal paper with coral), Kvällssol \"Skymning\" (Full palette, warm dusk with pine green), Hög kontrast \"Vitt\" (Restrained, 7:1 text, white or black paper, no grid).",
    "keyCharacteristics": [
      "Squared paper background (24 px grid, 1 px `--grid-line`) in every theme except Hög kontrast.",
      "Thick outlines (3 px) instead of shadows; hierarchy by size and outline weight.",
      "One done colour per theme, used for nothing else; the pencil-tick shape is constant.",
      "Care screens (pain, stop) are a heavy `--care` frame plus warning icon plus a bold word.",
      "Condensed heavy numerals for headings and counts; plain platform sans for everything else.",
      "Flat, no elevation; one authored motion (a tick drawing on)."
    ],
    "rules": [
      {
        "name": "The One Done Colour Rule",
        "body": "Each theme declares one `--done` and spends it only on completion. It is never a button, a link or decoration, and never close to `accent` or `care` (deltaE2000 at least 20). The pencil-tick shape is identical in every theme.",
        "section": "colors"
      },
      {
        "name": "The Care Is Extreme Rule",
        "body": "`--care` is the outermost lightness of its theme and is the only colour for pain, stop and warn. It is distinct from `done` and `accent`, and always arrives with an icon and a word.",
        "section": "colors"
      },
      {
        "name": "The Colour Is Never Alone Rule",
        "body": "Every state colour travels with an icon and a word (Klar, Idag, Kommande, Stopp) or a shape (the tick).",
        "section": "colors"
      },
      {
        "name": "The Tinted Not Shadowed Rule",
        "body": "Surfaces may use `surface` and `surface-tint` as well as `paper`; depth is still never made with a shadow, glass, gradient or coloured side-stripe.",
        "section": "colors"
      },
      {
        "name": "The Hundred-Percent Tabular Rule",
        "body": "Tabular numerals everywhere; any number that changes (sets, dates, weights) uses them.",
        "section": "typography"
      },
      {
        "name": "The Floor Rule",
        "body": "No text under 1rem.",
        "section": "typography"
      },
      {
        "name": "The Outline Not Shadow Rule",
        "body": "Priority is shown by outline colour, outline weight, size and tint step, never by shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** read every colour from a semantic token (`bg-paper`, `text-ink`, `text-done`, `border-care`); never hard-code hex in components.",
      "**Do** keep the 24 px squared grid on the body in light and dark, via `--grid-line`.",
      "**Do** use 3 px outlines for primary containers and the ink or edge pair to separate lead from receding.",
      "**Do** spend `--done` only on completion, and `--accent` on focus, selection, next and info.",
      "**Do** build care screens as a 6 px `--care` frame or heavy outline, the warning icon and a bold Swedish word.",
      "**Do** pair every state colour with an icon and a Swedish word, or the pencil-tick shape.",
      "**Do** keep text at 1rem or larger and primary targets at 56-64 px.",
      "**Do** use `.count` (Barlow Condensed 800, tabular) for any number that is a quantity.",
      "**Do** honour `prefers-reduced-motion` for any new animation; the tick draw-on is the single authored motion.",
      "**Do** run `npm test` (the contrast and deltaE gate) after touching `src/styles/themes/`."
    ],
    "donts": [
      "**Don't** add shadows, gradients, glass, gradient text or coloured side-stripes; depth is outline, size and tint step.",
      "**Don't** use `--done` for buttons, links or decoration, or give it a second meaning.",
      "**Don't** let `--care` be close to `--done` or `--accent` (deltaE2000 under 20).",
      "**Don't** replace pencil ticks with a standard check glyph in set or day marks.",
      "**Don't** use colour as the only carrier of state.",
      "**Don't** use `grid-line` for borders or text.",
      "**Don't** put the theme choice in backups or IndexedDB, or swap themes with `prefers-color-scheme` in CSS."
    ]
  }
}