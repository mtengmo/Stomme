{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/package-lock.json",
      "!**/screenshots",
      "!**/.impeccable"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "linter": { "enabled": true, "rules": { "recommended": true } },
  "overrides": [
    {
      "includes": ["src/rules/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "rules must stay pure: no react",
                  "react-dom": "rules must stay pure: no react-dom",
                  "dexie": "rules must stay pure: no dexie",
                  "dexie-react-hooks": "rules must stay pure: no hooks"
                },
                "patterns": [
                  {
                    "group": [
                      "**/db",
                      "**/db/**",
                      "**/features",
                      "**/features/**"
                    ],
                    "message": "rules must not import db or features"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "css": { "parser": { "tailwindDirectives": true } },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always" }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
