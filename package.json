{
  "name": "stomme",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Stomme: a personal knee-rehab strength programme PWA (Swedish UI).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "biome check && tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "audit:a11y": "tsx scripts/contrast.ts && tsx scripts/a11y-audit.ts",
    "shots": "npm run build && tsx scripts/screenshots.ts",
    "icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtengmo/Stomme.git"
  },
  "bugs": {
    "url": "https://github.com/mtengmo/Stomme/issues"
  },
  "homepage": "https://github.com/mtengmo/Stomme#readme"
}
